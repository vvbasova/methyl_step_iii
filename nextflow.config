outputDir = 'results'
workflow.output.mode = 'copy'

params {
    input = "${projectDir}/assets/samplesheet.csv"

    reference_fasta = 'https://raw.githubusercontent.com/nf-core/test-datasets/methylseq/reference/genome.fa.gz'

    containers = [
        fastqc:      'ghcr.io/taffish/fastqc:0.12.1-r1',
        trim_galore: 'ghcr.io/felixkrueger/trimgalore:v2.4.0',
        bismark:     'ghcr.io/felixkrueger/bismark:3.2.0',
        multiqc:     'ghcr.io/multiqc/multiqc:v1.33'
    ]
}

docker {
    enabled = true
    runOptions = '--platform linux/amd64'
}

process {
    executor = 'local'
    cpus = 2
    memory = 4.GB
    errorStrategy = 'terminate'
}
